# TEMPLATE ONLY — intentionally not deployable until separately authorized.
name = "hopev2-operational-receipt-collector"
main = "src/worker.mjs"
compatibility_date = "2026-11-10"
workers_dev = false
preview_urls = false

# Bounded Free-tier observability sampling. No paid exporter is configured.
[observability]
enabled = true
head_sampling_rate = 0.1

[observability.logs]
enabled = true
invocation_logs = true
head_sampling_rate = 0.1

[observability.traces]
enabled = true
head_sampling_rate = 0.01

[[d1_databases]]
binding = "DB"
database_name = "hopev2-operational-receipts"
database_id = "REPLACE_AFTER_EXPLICIT_AUTHORIZATION"
migrations_dir = "migrations"

# Template only; do not activate before separately authorized deployment.
[triggers]
crons = ["*/15 * * * *"]
