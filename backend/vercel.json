{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30,
      "includeFiles": "src/db/migrations/**/*.js"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/v1/health" },
    { "source": "/live", "destination": "/api/v1/live" },
    { "source": "/ready", "destination": "/api/v1/ready" }
  ]
}
